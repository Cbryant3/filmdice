DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moviedb
TMDB_API_KEY=YOUR_TMDB_KEY
TMDB_REGION=US
TMDB_AUTH_MODE=v3

# Frontend origins allowed to call the API (comma-separated). Defaults to the
# live site + localhost; Vercel previews are allowed automatically.
# Use "*" only for local testing (e.g. from a phone on your Wi-Fi).
# ALLOWED_ORIGINS=https://filmdice-bay.vercel.app,http://localhost:3000
